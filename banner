<svg width="800" height="220" viewBox="0 0 800 220" xmlns="http://www.w3.org/2000/svg">
  <style>
    .title { 
      font: bold 34px 'Segoe UI', Roboto, Helvetica, sans-serif; 
      fill: #D4AF37; 
      animation: neonText 3.5s infinite ease-in-out;
    }
    .subtitle { 
      font: 600 15px 'Segoe UI', Roboto, Helvetica, sans-serif; 
      fill: #C59B27; 
      letter-spacing: 0.5px;
    }
    .uni-text { 
      font: bold 13px 'Segoe UI', Roboto, Helvetica, sans-serif; 
      fill: #D4AF37; 
    }
    .badge-text { 
      font: bold 11px 'Segoe UI', Roboto, Helvetica, sans-serif; 
      fill: #FFFFFF; 
      letter-spacing: 1px; 
    }
    .code { 
      font: bold 24px monospace; 
      fill: #FFFFFF; 
    }
    .top-tag {
      font: bold 10px monospace;
      fill: #D4AF37;
      letter-spacing: 1.5px;
    }
    
    @keyframes neonText {
      0%, 100% { filter: drop-shadow(0 0 1px rgba(212, 175, 55, 0.3)); }
      50% { filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.85)) drop-shadow(0 0 14px rgba(212, 175, 55, 0.5)); }
    }

    @keyframes neonBox {
      0%, 100% { filter: drop-shadow(0 2px 4px rgba(212, 175, 55, 0.35)); transform: translateY(0px); }
      50% { filter: drop-shadow(0 4px 14px rgba(212, 175, 55, 0.9)); transform: translateY(-3px); }
    }

    @keyframes drawLine {
      0% { stroke-dashoffset: 200; }
      100% { stroke-dashoffset: 0; }
    }

    @keyframes fadeIn {
      0% { opacity: 0; }
      100% { opacity: 1; }
    }

    .animated-box { 
      animation: neonBox 3.5s infinite ease-in-out; 
    }
    .tech-line { 
      stroke: #D4AF37; 
      stroke-width: 1.8; 
      stroke-dasharray: 200; 
      animation: drawLine 2s forwards ease-out; 
    }
    .fade-in { 
      animation: fadeIn 1.2s ease-in; 
    }
  </style>
  
  <rect width="796" height="216" x="2" y="2" rx="14" fill="#FFFFFF" stroke="#D4AF37" stroke-width="2" />
  
  <path d="M 40 36 L 62 36" class="tech-line" fill="none"/>
  <circle cx="62" cy="36" r="2.5" fill="#D4AF37" class="fade-in"/>
  <text x="72" y="40" class="top-tag fade-in">PORTFOLIO · SOFTWARE DEVELOPMENT</text>

  <text x="40" y="95" class="title">Maximiliano Rodríguez Pavez</text>
  
  <text x="40" y="125" class="subtitle fade-in">
    | Software Development · Problem Solving · Systems &amp; Logic
  </text>
  
  <g class="fade-in">
    <rect x="40" y="155" width="165" height="26" rx="13" fill="#D4AF37" />
    <text x="122" y="172" class="badge-text" text-anchor="middle">COMPUTER SCIENCE</text>
    <text x="220" y="173" class="uni-text">PUCV · Chile</text>
  </g>

  <g transform="translate(670, 76)">
    <g class="animated-box">
      <rect width="68" height="68" rx="12" fill="#D4AF37" />
      <text x="34" y="42" class="code" text-anchor="middle">&lt;/&gt;</text>
      
      <path d="M -16 34 L 0 34" stroke="#D4AF37" stroke-width="1.5" />
      <circle cx="-16" cy="34" r="2.5" fill="#D4AF37" />
      
      <path d="M 34 -16 L 34 0" stroke="#D4AF37" stroke-width="1.5" />
      <circle cx="34" cy="-16" r="2.5" fill="#D4AF37" />

      <path d="M 34 68 L 34 84" stroke="#D4AF37" stroke-width="1.5" />
      <circle cx="34" cy="84" r="2.5" fill="#D4AF37" />
    </g>
  </g>

  <path d="M 40 217 L 210 217" stroke="#D4AF37" stroke-width="3" class="fade-in"/>
</svg>
